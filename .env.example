# Copy this to .env and fill in your values.
# .env is gitignored — never commit it.

HOME_URL="https://allegro.pl"
BASE_URL="https://allegro.pl/kategoria/rowery-i-akcesoria-rowery-16420"

# Scraper behaviour
SCRAPE_QUERY=rower szosowy
SCRAPE_SLEEP_MIN=3
SCRAPE_SLEEP_MAX=7
SCRAPE_HEADLESS=true
# MAX_PAGES=5    # uncomment to cap pages during testing; leave unset = all pages

# Paths (relative to project root)
DB_PATH=db/bikes.db

# CLIP model (open-clip-torch)
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=openai
# CLIP_CACHE_DIR=~/.cache/open_clip   # default; override if needed

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
