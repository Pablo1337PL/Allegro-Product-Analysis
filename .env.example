# Copy this to .env and fill in your values.
# .env is gitignored — never commit it.

HOME_URL="https://allegro.pl"
BASE_URL="https://allegro.pl/kategoria/rowery-i-akcesoria-rowery-16420"

# Search scraper
SCRAPER_CATEGORY_URL=https://allegro.pl/kategoria/rowery-szosowe-16484
SCRAPER_MIN_DELAY=3
SCRAPER_MAX_DELAY=7
# SCRAPER_MAX_PAGES=5    # uncomment to cap pages during testing; leave unset = all pages
# Note: the scraper always runs headful Firefox — DataDome blocks headless browsers.
# Cooldown (seconds) after a CAPTCHA/rate-limit page before restarting the browser
SCRAPER_CAPTCHA_COOLDOWN=900
# Stop the run after this many consecutive CAPTCHA hits (same page retried each time)
SCRAPER_MAX_CAPTCHA_RETRIES=3

# Detail scraper
DETAIL_BATCH_SIZE=50
DETAIL_RECHECK_DAYS=7
DETAIL_MIN_DELAY=6
DETAIL_MAX_DELAY=14
# Restart browser every N offers to stay under DataDome's ~250-offer session limit
DETAIL_SESSION_OFFERS=200
DETAIL_SESSION_BREAK=120
# Cooldown (seconds) after a CAPTCHA/rate-limit page before restarting session
DETAIL_CAPTCHA_COOLDOWN=900
# Stop the run after this many consecutive CAPTCHA hits
DETAIL_MAX_CAPTCHA_RETRIES=3

# Paths (relative to project root)
DB_PATH=db/bikes.db

# CLIP model (open-clip-torch)
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=openai
# CLIP_CACHE_DIR=~/.cache/open_clip   # default; override if needed

# is_bike classification (KMeans on thumbnail CLIP embeddings, runs right
# after the listing scrape — scraper/bike_classifier.py)
BIKE_CLUSTER_K=5
BIKE_MIN_OFFERS=25
# Poll interval (seconds) for scraper/thumbnail_embedder.py --watch, run in
# parallel with the listing scraper
THUMBNAIL_EMBED_POLL_INTERVAL=3

# Visual pipeline — YOLOv8 + SAM segmentation (Phase B)
SEGMENTATION_CONF_THRESHOLD=0.5
SEGMENTATION_BATCH_SIZE=25
# SEGMENTATION_YOLO_MODEL=yolov8n.pt
# SEGMENTATION_SAM_MODEL=sam2_b.pt

# Ollama (local LLM) — used by the inline spec extractor (detail scrape) and
# the condition pass. Both are skipped (degrade gracefully) if Ollama is down.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=30
BACKFILL_BATCH_SIZE=25
# Sampling/context for the spec extractor (greedy, deterministic decoding).
# num_ctx must be large enough to hold the whole cleaned description + prompt;
# latency on a 4 GB card scales with it, so keep it as small as fits the data.
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.0

# Inline spec_* + groupset/tier extraction during the detail scrape
# (producer-consumer queue, see scraper/ollama_extractor.py)
OLLAMA_EXTRACTOR_QUEUE_SIZE=500
# CONDITION_DEBUG_CSV=debug/ollama_condition.csv   # dump description+prompt+output per offer

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
